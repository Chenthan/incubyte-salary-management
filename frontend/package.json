{
  "name": "salary-management-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "e2e": "playwright test",
    "format": "prettier --write src e2e *.json *.ts",
    "format:check": "prettier --check src e2e *.json *.ts"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.8",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  }
}

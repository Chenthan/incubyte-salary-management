# scripts/run.sh (or run.ps1) generates an ignored .env automatically.
# Never commit actual credentials. Keep COOKIE_SECURE=true behind HTTPS.
DB_USERNAME=salary
DB_PASSWORD=replace-with-a-long-random-local-password
HR_USERNAME=hr
HR_PASSWORD=replace-with-a-long-random-local-password
APP_PORT=8080
COOKIE_SECURE=false
DEMO_SEED=true
